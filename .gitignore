sql_scripts/Isoworks_data_*.sql
*.dump
migrations/

# ── Secrets & local connection config ────────────────────────────────────────
.env
.env.*
*.dsn
db_config.ini
db_config.json

# ── Runtime logs ─────────────────────────────────────────────────────────────
*.log
migration_phase_refactor.log

# ── Python bytecode & caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Build / distribution ──────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/

# ── Temporary & OS files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/

# ── Claude Code internal session data ─────────────────────────────────────────
.claude/

